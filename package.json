{
  "name": "qunar-travel-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "dev:test": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5174 --strictPort",
    "build": "bun run typecheck && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "supabase": "node node_modules/supabase/dist/supabase.js",
    "supabase:start": "node node_modules/supabase/dist/supabase.js start",
    "supabase:stop": "node node_modules/supabase/dist/supabase.js stop",
    "supabase:db:test": "node node_modules/supabase/dist/supabase.js test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dompurify": "^3.4.16",
    "ky": "^2.1.0",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.1.1",
    "supabase": "^2.118.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
